{
  "name": "pcb-layout",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "bun run dev:api & bun run dev:web & wait",
    "dev:api": "bun run --watch apps/api-server/src/index.ts",
    "dev:web": "bunx vite --config apps/web-client/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"No linter configured yet\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0"
  }
}
